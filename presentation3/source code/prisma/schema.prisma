generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Employee {
  Employee_ID    Int             @id
  Name           String          @db.VarChar(100)
  Email          String?         @unique(map: "Email") @db.VarChar(100)
  Phone          String?         @db.VarChar(15)
  Department     String?         @db.VarChar(100)
  Designation    String?         @db.VarChar(100)
  ATTENDANCE     Attendance[]
  EMPLOYEE_SHIFT EmployeeShift[]
  LEAVE          LEAVE[]
  USER_ADMIN     AdminUser?

  @@map("EMPLOYEE")
}

model Shift {
  Shift_ID       Int             @id
  Shift_Name     String          @db.VarChar(50)
  Start_Time     DateTime        @db.Time(0)
  End_Time       DateTime        @db.Time(0)
  EMPLOYEE_SHIFT EmployeeShift[]

  @@map("SHIFT")
}

model EmployeeShift {
  Employee_ID   Int
  Shift_ID      Int
  Assigned_Date DateTime @db.Date
  EMPLOYEE      Employee @relation(fields: [Employee_ID], references: [Employee_ID], onDelete: NoAction, onUpdate: NoAction, map: "employee_shift_ibfk_1")
  SHIFT         Shift    @relation(fields: [Shift_ID], references: [Shift_ID], onDelete: NoAction, onUpdate: NoAction, map: "employee_shift_ibfk_2")

  @@id([Employee_ID, Shift_ID, Assigned_Date])
  @@index([Shift_ID], map: "Shift_ID")
  @@map("EMPLOYEE_SHIFT")
}

model Attendance {
  Attendance_ID Int       @id
  Employee_ID   Int
  Date          DateTime  @db.Date
  Check_In      DateTime? @db.Time(0)
  Check_Out     DateTime? @db.Time(0)
  Status        String?   @db.VarChar(20)
  EMPLOYEE      Employee  @relation(fields: [Employee_ID], references: [Employee_ID], onDelete: NoAction, onUpdate: NoAction, map: "attendance_ibfk_1")

  @@unique([Employee_ID, Date], map: "Employee_ID")
  @@map("ATTENDANCE")
}

model AdminUser {
  User_ID     Int       @id
  Employee_ID Int?      @unique(map: "Employee_ID")
  Username    String    @unique(map: "Username") @db.VarChar(50)
  Role        String    @db.VarChar(20)
  EMPLOYEE    Employee? @relation(fields: [Employee_ID], references: [Employee_ID], onDelete: NoAction, onUpdate: NoAction, map: "user_admin_ibfk_1")

  @@map("USER_ADMIN")
}

model LEAVE {
  Leave_ID    Int       @id
  Employee_ID Int
  Leave_Type  String?   @db.VarChar(50)
  Start_Date  DateTime? @db.Date
  End_Date    DateTime? @db.Date
  Reason      String?   @db.VarChar(255)
  Status      String?   @db.VarChar(20)
  EMPLOYEE    Employee  @relation(fields: [Employee_ID], references: [Employee_ID], onDelete: NoAction, onUpdate: NoAction, map: "leave_ibfk_1")

  @@index([Employee_ID], map: "Employee_ID")
}
